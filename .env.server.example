# ============================================================
#  .env untuk SERVER (Docker). Salin jadi ".env" di folder project server:
#      cp .env.server.example .env   lalu edit dengan: nano .env
#  File ini contoh; .env asli JANGAN di-commit ke GitHub.
#  Hindari karakter $ # " ' dan spasi di password.
# ============================================================

APP_NAME="UBP Mahakam"
APP_ENV=production
APP_DEBUG=false
# isi dengan hasil: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# alamat yang dibuka di browser (penting agar gambar upload tampil)
APP_URL=http://10.8.238.172:8080
# port di server
APP_PORT=8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# database berjalan di container "db" (dibuat otomatis oleh docker compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ubp_mahakam
DB_USERNAME=ubp
DB_PASSWORD=GantiPasswordDb123
DB_ROOT_PASSWORD=GantiPasswordRoot123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log

# akun admin pertama (dibuat sekali dengan db:seed)
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@landingpage.com
ADMIN_PASSWORD=GantiPasswordAdmin123
